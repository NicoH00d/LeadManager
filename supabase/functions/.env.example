# Copia este archivo a supabase/functions/.env (ignorado por git) y súbelo con:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase; no van aquí.

# --- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp) ---
WHATSAPP_VERIFY_TOKEN=un-texto-secreto-que-tu-inventas
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0

# --- Claude ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
# Solo aplica a claude-opus-5-5 / claude-sonnet-5-5 (Haiku lo ignora)
LLM_EFFORT=low

# --- Transcripción de notas de voz (OpenAI) ---
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Bot ---
# auto: responde directo. sombra: guarda borradores para aprobación humana.
BOT_MODO=auto
DEBOUNCE_MS=8000

# --- Cron (mismo valor que el secreto 'cron_secret' en Vault) ---
CRON_SECRET=
